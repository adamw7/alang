{
  "tool": "grid_path",
  "examples": [
    {"args": {"grid": ["..", ".."]}, "expect": 2},
    {"args": {"grid": [".#", "#."]}, "expect": -1},
    {"args": {"grid": ["."]}, "expect": 0}
  ],
  "hidden": [
    {"args": {"grid": ["#"]}, "expect": -1},
    {"args": {"grid": ["...", "##.", "..."]}, "expect": 4},
    {"args": {"grid": ["........", "........", "........", "........", "........", "........", "........", "........"]}, "expect": 14},
    {"args": {"grid": ["........"]}, "expect": 7},
    {"args": {"grid": [".", ".", ".", ".", ".", ".", ".", "."]}, "expect": 7},
    {"args": {"grid": [".#......", ".#.####.", ".#.#..#.", ".#.#.##.", ".#.#....", ".#.####.", ".#......", "...#####"]}, "expect": -1},
    {"args": {"grid": ["#.", ".."]}, "expect": -1},
    {"args": {"grid": ["..", ".#"]}, "expect": -1},
    {"args": {"grid": ["....#", "###.#", "....#", ".####", "....."]}, "expect": 14},
    {"args": {"grid": [".#.", ".#.", "..."]}, "expect": 4},
    {"args": {"grid": ["."]}, "expect": 0},
    {"args": {"grid": ["..."]}, "expect": 2},
    {"args": {"grid": ["...."]}, "expect": 3},
    {"args": {"grid": [".##", ".#.", "...", "##.", ".#.", ".##", "..."]}, "expect": -1},
    {"args": {"grid": ["#.", ".."]}, "expect": -1},
    {"args": {"grid": [".", "#", ".", "."]}, "expect": -1}
  ]
}
