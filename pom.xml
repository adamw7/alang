<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.adamw7</groupId>
  <artifactId>alang</artifactId>
  <version>0.2.0</version>
  <packaging>jar</packaging>
  <name>ALang</name>
  <description>An agent-first, heap-free programming language.</description>
  <url>https://github.com/adamw7/alang</url>

  <licenses>
    <license>
      <name>MIT</name>
      <url>https://opensource.org/license/mit</url>
    </license>
  </licenses>

  <scm>
    <url>https://github.com/adamw7/alang</url>
    <connection>scm:git:https://github.com/adamw7/alang.git</connection>
  </scm>

  <!-- `mvn deploy` publishes the jar, its pom and the release archives to GitHub Packages; the
       release workflow (.github/workflows/release.yml) runs it for a v* tag. The credentials come
       from the `github` server in settings.xml, which actions/setup-java writes. -->
  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/adamw7/alang</url>
    </repository>
  </distributionManagement>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <antlr.version>4.13.2</antlr.version>
    <junit.version>6.1.3</junit.version>
    <archunit.version>1.5.1</archunit.version>
    <pitest.version>1.30.2</pitest.version>
    <pitest.junit5.version>1.2.3</pitest.junit5.version>
    <!-- Parallel mutation-testing JVMs; override with -Dpitest.threads=N. -->
    <pitest.threads>4</pitest.threads>
    <!-- Limit in seconds for the whole test run (it takes about 20 s). Surefire then kills the test
         JVM and fails the build with "There was a timeout in the fork", leaving a thread dump in
         target/surefire-reports. Each test also fails after 10 s on its own
         (src/test/resources/junit-platform.properties). Override with -Dsurefire.timeout=N; 0 turns
         the limit off. -->
    <surefire.timeout>180</surefire.timeout>
  </properties>

  <!-- One JUnit Platform version for Jupiter and the ArchUnit engine. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.antlr</groupId>
      <artifactId>antlr4-runtime</artifactId>
      <version>${antlr.version}</version>
      <!-- The shade plugin puts the runtime inside alang.jar. Optional keeps it out of the
           dependencies of a project that uses the published jar, which would get it twice. -->
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>alang</finalName>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- The guide for agents travels with the jar: a JVM host can read it with
           getResourceAsStream("/alang/AGENTS.md") and hand it to its model. -->
      <resource>
        <directory>${project.basedir}</directory>
        <targetPath>alang</targetPath>
        <includes>
          <include>AGENTS.md</include>
        </includes>
      </resource>
      <!-- The jar contains the ANTLR runtime, whose license asks binaries to carry its notice. -->
      <resource>
        <directory>${project.basedir}</directory>
        <targetPath>META-INF</targetPath>
        <includes>
          <include>LICENSE</include>
          <include>THIRD-PARTY-NOTICES</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <!-- Generates the parser from grammar/ALang.g4 on every build. -->
      <plugin>
        <groupId>org.antlr</groupId>
        <artifactId>antlr4-maven-plugin</artifactId>
        <version>${antlr.version}</version>
        <configuration>
          <sourceDirectory>${project.basedir}/grammar</sourceDirectory>
          <visitor>true</visitor>
          <listener>false</listener>
          <treatWarningsAsErrors>true</treatWarningsAsErrors>
          <arguments>
            <argument>-package</argument>
            <argument>alang.parser</argument>
          </arguments>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>antlr4</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <compilerArgs>
            <arg>-Xlint:all,-serial,-processing</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.1</version>
        <configuration>
          <forkedProcessTimeoutInSeconds>${surefire.timeout}</forkedProcessTimeoutInSeconds>
        </configuration>
      </plugin>

      <!-- Mutation testing (PIT): seeds small bugs into the compiled toolchain and checks that
           the tests catch them. Not bound to the lifecycle (it takes minutes); run it with
             mvn test-compile pitest:mutationCoverage
           The report is written to target/pit-reports/index.html. -->
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>${pitest.version}</version>
        <dependencies>
          <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-junit5-plugin</artifactId>
            <version>${pitest.junit5.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <targetClasses>
            <param>alang.*</param>
          </targetClasses>
          <excludedClasses>
            <!-- Generated by ANTLR from grammar/ALang.g4. -->
            <param>alang.parser.*</param>
            <!-- Only CBackendTest can detect a C backend mutant, and it compiles every program
                 with gcc and clang: hours per campaign instead of minutes. -->
            <param>alang.cgen.*</param>
          </excludedClasses>
          <targetTests>
            <param>alang.*</param>
          </targetTests>
          <excludedTestClasses>
            <!-- The ArchUnit rules read class files from disk, so they never see an in-memory mutant. -->
            <param>alang.*ArchitectureTest</param>
            <param>alang.CBackendTest</param>
            <!-- These two only check that the toolchain does not crash or change its mind: FuzzTest on
                 thousands of corrupted programs, DeterminismTest across repeated runs and locales. So
                 they notice a mutant only when it crashes, and the exact-output tests (tests/errors
                 with their .err files, CliTest's JSON reports) notice all of those too. Together they
                 were two thirds of the run. Both still run in `mvn verify`, and the fuzzer in its own
                 CI job. -->
            <param>alang.DeterminismTest</param>
            <param>alang.FuzzTest</param>
          </excludedTestClasses>
          <threads>${pitest.threads}</threads>
          <!-- Print "N mutations completed" every 30 seconds instead of a spinner. The spinner never
               ends its line, so a CI log showed no output at all until the run was over. -->
          <features>
            <feature>+progress</feature>
          </features>
          <verbosity>NO_SPINNER</verbosity>
          <!-- By default PIT makes one analysis unit per class, and the count stayed at 0 until
               all of Checker's ~900 mutants were done. Smaller units keep the count moving and
               spread Checker over every thread; each unit starts a fresh test JVM, so much smaller
               units only add start-up time (50 per unit was 20% slower). -->
          <mutationUnitSize>100</mutationUnitSize>
          <jvmArgs>
            <!-- Some mutants loop forever while allocating. A small heap ends them quickly with
                 MEMORY_ERROR (counted as killed, like a timeout) instead of minutes of garbage
                 collection before the timeout fires. The tests need far less. -->
            <value>-Xmx256m</value>
            <!-- Compile with C1 only. PIT swaps each mutant into the running test JVM, which throws
                 away the compiled code of the class it replaces, and the JVM itself lives for at
                 most 100 mutants. C2's slow, optimizing compiles rarely pay off before then; they
                 only take CPU from the tests. This halves the run, with the same mutants killed. -->
            <value>-XX:TieredStopAtLevel=1</value>
            <!-- One collector thread instead of G1's several, which compete with the parallel
                 test JVMs; enough for a 256 MB heap. A few percent faster. -->
            <value>-XX:+UseSerialGC</value>
          </jvmArgs>
          <!-- A ratchet: the build fails when either score drops below these percentages.
               Raise them as the tests improve. -->
          <mutationThreshold>74</mutationThreshold>
          <testStrengthThreshold>85</testStrengthThreshold>
          <timestampedReports>false</timestampedReports>
          <outputFormats>
            <param>HTML</param>
            <param>XML</param>
          </outputFormats>
        </configuration>
      </plugin>

      <!-- Produces target/alang.jar, a single runnable jar. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>alang.cli.Main</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Produces target/alang-VERSION.zip and .tar.gz, the release archives: the jar, a launcher,
           AGENTS.md and the docs (see src/dist/assembly.xml). Declared after the shade plugin, so
           it runs after it in the package phase and packs the shaded jar. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>3.8.0</version>
        <executions>
          <execution>
            <id>dist</id>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
            <configuration>
              <descriptors>
                <descriptor>src/dist/assembly.xml</descriptor>
              </descriptors>
              <finalName>alang-${project.version}</finalName>
              <appendAssemblyId>false</appendAssemblyId>
              <tarLongFileMode>posix</tarLongFileMode>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
