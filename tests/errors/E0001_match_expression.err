error[E0001]: unexpected '{', expected a statement or expression
 --> tests/errors/E0001_match_expression.al:4:39
  |
4 |     let word: str[8] = match n { 1 => { "one" } _ => { "many" } };
  |                                       ^
  = hint: the arms of a match expression are values, not blocks: let x: str[8] = match n { 1 => "one", _ => "many" }; for statements in an arm, use a match statement: match n { 1 => { ... } _ => { ... } }

