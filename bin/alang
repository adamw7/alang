#!/usr/bin/env sh
# ALang launcher: builds target/alang.jar when it is missing or older than the sources, then runs it.
set -e
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
JAR="$ROOT/target/alang.jar"
# The JVM announces JAVA_TOOL_OPTIONS and _JAVA_OPTIONS on stderr ("Picked up JAVA_TOOL_OPTIONS: ...")
# each time it starts, which buries the diagnostics in a sandbox that sets one for a proxy or a JVM
# workaround. Give the same options on the command line instead, where they apply the same way
# unannounced: in this order, so that _JAVA_OPTIONS still wins, as it does over the other. A value with
# quotes, which the JVM would read as one option with spaces, is left as it is.
opts=""
for var in JAVA_TOOL_OPTIONS _JAVA_OPTIONS; do
  eval "value=\"\${$var:-}\""
  case "$value" in
    *\"* | *\'*) ;;
    *) opts="$opts${opts:+${value:+ }}$value"; unset "$var" ;;
  esac
done
if [ ! -f "$JAR" ]; then
  reason="first run"
elif [ -n "$(find "$ROOT/pom.xml" "$ROOT/grammar" "$ROOT/src/main" -newer "$JAR" -print | head -n 1)" ]; then
  # Any change to the toolchain's sources (Java, the grammar, the C prelude, the build) since the jar
  # was built; without this check an edit or a `git pull` would keep running the old toolchain.
  reason="sources changed"
fi
if [ -n "${reason:-}" ]; then
  echo "alang: building $JAR ($reason)..." >&2
  (cd "$ROOT" && MAVEN_OPTS="${MAVEN_OPTS:-}${MAVEN_OPTS:+${opts:+ }}$opts" mvn -q -B -DskipTests package >&2)
fi
# Java decodes command-line arguments (file names, `alang call` JSON) with the host locale's
# charset; under a POSIX/C locale every non-ASCII byte would be replaced. Use UTF-8 so the
# result never depends on the host locale (the toolchain's own output is locale-independent).
set -f    # split the options on spaces, but never expand a `*` in them (as in http.nonProxyHosts)
# shellcheck disable=SC2086
set -- $opts -jar "$JAR" "$@"
set +f
exec env LC_ALL=C.UTF-8 java "$@"
