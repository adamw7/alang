#!/usr/bin/env sh
# ALang launcher in the release archive: runs lib/alang.jar with Java 21 or newer (JAVA_HOME, else
# `java` on PATH). Unlike the launcher in the source tree, it needs neither Maven nor the sources.
set -e
# Follow symlinks, so a link to this script from a directory on PATH still finds lib/alang.jar.
self="$0"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in
    /*) self="$link" ;;
    *) self="$(dirname -- "$self")/$link" ;;
  esac
done
ROOT="$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)"
# The JVM announces JAVA_TOOL_OPTIONS on stderr ("Picked up JAVA_TOOL_OPTIONS: ...") each time it starts,
# which buries the diagnostics in a sandbox that sets it for a proxy. Give the same options on the
# command line instead, where they apply the same way unannounced. A value with quotes, which the JVM
# would read as one option with spaces, is left as it is.
opts=""
case "${JAVA_TOOL_OPTIONS:-}" in
  *\"* | *\'*) ;;
  *) opts="${JAVA_TOOL_OPTIONS:-}"; unset JAVA_TOOL_OPTIONS ;;
esac
# Java decodes command-line arguments (file names, `alang call` JSON) with the host locale's
# charset; under a POSIX/C locale every non-ASCII byte would be replaced. Use UTF-8 so the
# result never depends on the host locale (the toolchain's own output is locale-independent).
set -f    # split the options on spaces, but never expand a `*` in them (as in http.nonProxyHosts)
# shellcheck disable=SC2086
set -- $opts -jar "$ROOT/lib/alang.jar" "$@"
set +f
exec env LC_ALL=C.UTF-8 "${JAVA_HOME:+$JAVA_HOME/bin/}java" "$@"
